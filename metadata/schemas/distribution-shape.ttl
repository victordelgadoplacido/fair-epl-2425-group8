@prefix : <http://fairdatapoint.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

:Section1Group
  a sh:PropertyGroup ;
  rdfs:label "Basic Description" ;
  sh:order 0 .

:Section2Group
  a sh:PropertyGroup ;
  rdfs:label "Access & format" ;
  sh:order 1 .

:Section3Group
  a sh:PropertyGroup ;
  rdfs:label "License & provenance" ;
  sh:order 2 .

:EPLDistributionShape
  a sh:NodeShape ;
  rdfs:label "Group 8 – EPL 2024/25 Distribution" ;
  sh:targetClass dcat:Distribution ;
  sh:property [
    sh:path dct:title ;
    sh:name "Title" ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :Section1Group
  ] ;
  sh:property [
    sh:path dct:description ;
    sh:name "Description" ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:order 1 ;
    dash:editor dash:TextAreaEditor ;
    sh:group :Section1Group
  ] ;
  sh:property [
    sh:path dcat:downloadURL ;
    sh:name "Download URL" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
    dash:editor dash:URIEditor ;
    sh:group :Section2Group
  ] ;
  sh:property [
    sh:path dcat:mediaType ;
    sh:name "Media type" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 1 ;
    dash:editor dash:URIEditor ;
    sh:group :Section2Group
  ] ;
  sh:property [
    sh:path dct:format ;
    sh:name "Format" ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:order 2 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :Section2Group
  ] ;
  sh:property [
    sh:path dcat:byteSize ;
    sh:name "Byte size" ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:minInclusive 0 ;
    sh:order 3 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :Section2Group
  ] ;
  sh:property [
    sh:path dct:license ;
    sh:name "License" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
    dash:editor dash:URIEditor ;
    sh:group :Section3Group
  ] ;
  sh:property [
    sh:path dct:conformsTo ;
    sh:name "Conforms to" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ;
    sh:order 1 ;
    dash:editor dash:URIEditor ;
    sh:group :Section3Group
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:name "Derived from" ;
    sh:nodeKind sh:IRI ;
    sh:order 2 ;
    dash:editor dash:URIEditor ;
    sh:group :Section3Group
  ] .