@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/FAIR-course-UT/2026/group08/metadata/dataset> a dcat:Dataset ;
    dct:title "English Premier League match results 2024/25 (FAIRified)" ;
    dct:description "Results of all 380 English Premier League matches of the 2024/25 season: date, home and away team, full- and half-time goals, result and referee. FAIRified as RDF with schema.org, a Group 8 ontology and links to Wikidata." ;
    dcat:keyword "football", "Premier League", "match results", "2024/2025", "England" ;
    dcat:landingPage <https://github.com/victordelgadoplacido/fair-epl-2425-group8> ;
    dct:identifier "https://w3id.org/FAIR-course-UT/2026/group08/metadata/dataset"^^xsd:anyURI ;
    dct:temporal [
        a dct:PeriodOfTime ;
        dcat:startDate "2024-08-16"^^xsd:date ;
        dcat:endDate "2025-05-25"^^xsd:date
    ] ;
    dct:spatial <http://www.wikidata.org/entity/Q21> ;
    dct:license <https://opendatacommons.org/licenses/pddl/> ;
    dct:creator <https://github.com/victordelgadoplacido>, <https://github.com/Cabanes02> ;
    prov:wasDerivedFrom <https://datahub.io/football/english-premier-league/_r/-/season-2425.csv> ;
    dct:issued "2026-10-25"^^xsd:date ;
    dcat:distribution <https://w3id.org/FAIR-course-UT/2026/group08/metadata/distribution-original>, <https://w3id.org/FAIR-course-UT/2026/group08/metadata/distribution-rdf> .
